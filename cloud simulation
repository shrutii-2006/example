CloudSim.init(1, null, false);
// Create a VM
Vm vm = createVm();
// Print VM information
System.out.println("VM created: " + vm.getId());
// Start the simulation (although no datacenter is created)
CloudSim.startSimulation();
CloudSim.stopSimulation();
System.out.println("Simulation finished!");
} catch (Exception e) {
e.printStackTrace();
}
}
private static Vm createVm() {
// Create and return a VM with specified parameters
return new Vm(0, 0, 1000, 1, 512, 1000, 10000, "Xen", null);
}
}
